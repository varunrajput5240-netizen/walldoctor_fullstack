# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
# Local dev default: SQLite file, zero setup.
# For production, point this at a free-tier Postgres instance, e.g. Neon.tech or Supabase:
# DATABASE_URL=postgresql+psycopg2://user:password@host/dbname
DATABASE_URL=sqlite:///./walldoctor.db

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-generate-a-real-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI diagnosis ---
# Server-side only. NEVER expose this to the frontend/browser.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Misc ---
ENVIRONMENT=development
